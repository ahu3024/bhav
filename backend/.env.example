# Google Earth Engine — required for NDVI ingest.
# Either run `earthengine authenticate` once, or set a Cloud project here:
EE_PROJECT=

# --- WhatsApp delivery: Meta WhatsApp Cloud API ---------------------------
# From Meta for Developers -> your app -> WhatsApp -> API Setup.
# The API Setup page issues a 24-hour test token; for anything beyond a demo
# create a System User token instead, which does not expire.
WHATSAPP_ACCESS_TOKEN=
# The numeric *ID* shown under "Phone number ID" — not the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# Meta only allows free-form text within 24h of the recipient's last message.
# Outside that window a pre-approved template is the only thing that sends.
# Create one with a single {{1}} body variable and name it here.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# Handy for testing.
TEST_PHONE=
