# Local defaults. On a host these are set in the platform's environment instead
# — see ../DEPLOY.md. Anything left blank falls back to the value in config.py.

# --- Data + model location -------------------------------------------------
# Where the live SQLite file and the pickles are read and written. Unset means
# in-tree (backend/data, backend/models), which is what you want locally. On a
# host, point these at a mounted disk so registrations survive a deploy:
#   BHAV_DATA_DIR=/var/data
#   BHAV_MODELS_DIR=/var/data/models
BHAV_DATA_DIR=
BHAV_MODELS_DIR=
# What a deploy carrying a newer data/seed.db does with it:
#   missing  (default) copy only what isn't there. The disk wins.
#   refresh  replace the pipeline tables, keep subscribers and the message log.
#   never    touch nothing.
BHAV_SEED_MODE=

# --- Serving ---------------------------------------------------------------
# Guards /broadcast, /message/send, /message/qr and the subscriber endpoints.
# Leave blank locally; SET IT ON ANY HOST. Without it, /broadcast can message
# every subscriber and /message/qr hands a stranger a code that links their
# WhatsApp account to your deployment.
BHAV_ADMIN_TOKEN=
# Comma-separated browser origins. Blank = "*", fine locally.
#   BHAV_CORS_ORIGINS=https://bhav-web.onrender.com
BHAV_CORS_ORIGINS=
# Seconds a browser or CDN may reuse a response before revalidating (default
# 300). Responses carry an ETag either way, so a revalidation is a 304 unless
# the pipeline has actually run.
BHAV_CACHE_MAX_AGE=
# Registrations allowed per IP per hour (default 5). /subscribe is public and
# sends a WhatsApp message, so it is worth a limit.
BHAV_SUBSCRIBE_LIMIT=

# --- Google Earth Engine ---------------------------------------------------
# Required for NDVI ingest only — the API never imports it.
# Either run `earthengine authenticate` once, or set a Cloud project here:
EE_PROJECT=

# --- WhatsApp delivery: open-wa bridge ------------------------------------
# Sending runs through a real WhatsApp account driven by open-wa
# (https://open-wa.org), in the Node service under whatsapp/. Start it with
# `npm start` there, then link a phone once by scanning the pairing QR at
# http://localhost:8000/message/qr — WhatsApp -> Linked devices -> Link a device.
#
# Unlike Meta's Cloud API there is no 24-hour window and no approved template:
# a farmer who never messaged us first still receives the alert.
#
# Accepts a bare host:port as well as a full URL, so a platform that wires
# services together for you can set it directly.
WA_BRIDGE_URL=http://localhost:3001
# Shared secret between this backend and the bridge. Set the same value in the
# bridge's environment. Leave both blank only on a throwaway local machine —
# the bridge can message anyone from the linked account.
WA_BRIDGE_TOKEN=

# Handy for testing.
TEST_PHONE=
