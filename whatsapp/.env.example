# Local defaults. On a host these come from the platform — see ../DEPLOY.md.

# Must match backend/.env.
WA_BRIDGE_TOKEN=
# Refuse to start without a token. Leave blank locally; set it to 1 on any host.
# A bridge with no token looks healthy and will message anyone who asks, from a
# real WhatsApp account.
WA_REQUIRE_TOKEN=

# PORT (set by most platforms) wins over this.
WA_BRIDGE_PORT=3001
WA_SESSION_ID=bhav

# Where the linked account lives — it is a Chrome profile, so this directory IS
# the linkage. On a host this MUST be a mounted disk, or every deploy asks for
# the pairing QR to be scanned again. Blank = whatsapp/.sessions/ (local only).
#   WA_SESSION_DIR=/var/data/wa-sessions
WA_SESSION_DIR=

# System Chromium — the puppeteer postinstall download is blocked here, and the
# Docker image installs the distro's browser instead.
WA_CHROME_PATH=/usr/bin/chromium

# Where STOP / START opt-outs are forwarded. Accepts a bare host:port too.
BHAV_API_URL=http://localhost:8000
