# Puppeteer's postinstall tries to download its own Chrome from
# googlechromelabs.github.io, which is unreachable from this environment — and
# because that postinstall exits non-zero, npm rolls the *entire* install back
# and leaves node_modules empty. Skip the download and point open-wa at a
# browser already on the machine via WA_CHROME_PATH in .env.
puppeteer_skip_download=true
